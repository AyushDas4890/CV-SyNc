From 853bfe0dbfe812d6dc94fc52393ab492dd15c6d9 Mon Sep 17 00:00:00 2001
From: Ayush Das <das.ayush4890@gmail.com>
Date: Wed, 29 Jul 2026 10:04:33 +0530
Subject: [PATCH 1/2] fix: PORT fallback, configurable compile timeout, real
 error logging
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- server.config.js: PORT had no fallback, so `npm run dev` without a .env
  started the server on `undefined`. Docker sets PORT, which is why this only
  ever bit bare local runs. Now `process.env.PORT || 3000`.
- latex.service.js: COMPILE_TIMEOUT_MS was hardcoded to 15s while the README
  documented 30s. Made it env-configurable (COMPILE_TIMEOUT_MS) and raised the
  default to 60s — xelatex/fontspec templates (plushcv, deedy, awesome-cv)
  routinely exceed 15s on a cold run and were being SIGKILLed mid-compile,
  which surfaces to the caller as an opaque failure rather than a LaTeX error.
- latex.controller.js: the 422 branch logged the fixed string
  'invalid respone from controleer', discarding the compile log and the parsed
  error list it had just built. Now logs both, so a failed compile is
  diagnosable from the service logs and not only from the HTTP response.
---
 src/config/server.config.js        | 2 +-
 src/controller/latex.controller.js | 2 +-
 src/service/latex.service.js       | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/config/server.config.js b/src/config/server.config.js
index 3cb6c80..9897174 100644
--- a/src/config/server.config.js
+++ b/src/config/server.config.js
@@ -3,6 +3,6 @@ const dotenv = require('dotenv');
 dotenv.config();
 
 module.exports = {
-  PORT: process.env.PORT,
+  PORT: process.env.PORT || 3000,
   logger_level: process.env.logger_level || 'info',
 };
diff --git a/src/controller/latex.controller.js b/src/controller/latex.controller.js
index 896c331..cc8f106 100644
--- a/src/controller/latex.controller.js
+++ b/src/controller/latex.controller.js
@@ -34,7 +34,7 @@ class LatexController {
         logger.info('Sucessfully sent response ack from controler');
         return res.send(result.pdfBuffer);
       } else {
-        logger.error('invalid respone from controleer');
+        logger.error({ log: result.log, errors: result.errors }, 'LaTeX compilation failed');
         return res.status(422).json({
           ok: false,
           log: result.log,
diff --git a/src/service/latex.service.js b/src/service/latex.service.js
index a359a36..4a355d1 100644
--- a/src/service/latex.service.js
+++ b/src/service/latex.service.js
@@ -5,7 +5,7 @@ const path = require('path');
 const { spawn } = require('child_process');
 const logger = require('../config/logger.config');
 
-const COMPILE_TIMEOUT_MS = 15000; // 15 seconds timeout
+const COMPILE_TIMEOUT_MS = parseInt(process.env.COMPILE_TIMEOUT_MS || '60000', 10); // default 60s
 const MAX_LOG_CHARS = 20000;
 
 function runLatexmk(dir, engine = 'pdflatex') {
