# Copy this file to .env and fill in real values before running `docker compose up`.
# docker-compose.yml reads these via ${VAR} interpolation.

# CV_BRAIN
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=8192
# Comma-separated CORS allowlist for CV_BRAIN. /api/generate-cv burns LLM
# credits, so never widen this to "*".
ALLOWED_ORIGINS=http://localhost:5173

# auth-service — GitHub OAuth App (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
# read:user identifies the user and lists public repos. public_repo is a
# WRITE scope (push access to all your public repos) and is not needed.
GITHUB_OAUTH_SCOPE=read:user

# auth-service — Google OAuth App (console.cloud.google.com)
# Present but intentionally unmounted — the Google login path is not wired up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

FRONTEND_URL=http://localhost:5173

# Session signing key. Generate with:  openssl rand -hex 32
# The service refuses to start in production if this is left at a default.
SESSION_SECRET=dev-secret-change-me

# Only if the frontend is on a different registrable domain than the API.
# "none" requires HTTPS.
# COOKIE_SAMESITE=lax

# Local-dev-only escape hatch for corporate SSL-inspection proxies.
# Prefer NODE_EXTRA_CA_CERTS=/path/to/proxy-ca.pem instead; this disables
# TLS certificate verification and is ignored when NODE_ENV=production.
# ALLOW_INSECURE_TLS=false

# frontend — baked into the bundle at BUILD time (docker compose build args)
VITE_API_URL=http://localhost:4000
VITE_LLM_BRAIN_URL=http://localhost:8000
VITE_CV_BUILDER_URL=http://localhost:3000
