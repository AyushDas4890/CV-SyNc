# Copy to vercel.env and fill in. Used by scripts/vercel-sync.sh and by
# docker-compose.vercel.yml (frontend on Vercel, backends on this PC).
#
#   cp vercel.env.example vercel.env
#
# vercel.env is gitignored — it holds real secrets. Never commit it.

# ── Required ─────────────────────────────────────────────────────────────

# Session signing key. auth-service runs with NODE_ENV=production in this
# setup and refuses to boot on the placeholder value, on purpose: a guessable
# secret lets anyone forge a session cookie.
#   openssl rand -hex 32
SESSION_SECRET=

# GitHub OAuth App credentials — https://github.com/settings/developers
# Set the App's "Authorization callback URL" to your Vercel URL plus
# /api/auth/github/callback (scripts/vercel-sync.sh prints the exact string).
# Do NOT point it at the tunnel: the tunnel hostname changes on every restart,
# the Vercel one does not.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# At least one LLM key, or /api/generate-cv has nothing to call.
# OpenAI is primary, Groq is the fallback — set both if you can, so a rate
# limit on one is not the end of the run.
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Filled in automatically ──────────────────────────────────────────────

# Your production Vercel URL, e.g. https://cv-sync.vercel.app
# Leave blank on the first run: vercel-sync.sh derives it from the linked
# project and appends it here. Set it by hand only if Vercel gave the project
# a different production alias than the script guessed.
PUBLIC_APP_URL=
