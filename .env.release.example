# CV-Sync release env template.
#
# Copy this to a file OUTSIDE the project (e.g. ~/cvsync/cvsync.env), fill in
# real values, and point compose at it:
#
#   docker compose -f docker-compose.release.yml --env-file cvsync.env up -d
#
# Nothing here is baked into any image — these are read at container start.
# Keep this file out of version control once it holds real keys.

# ── Which images to run ────────────────────────────────────────────────────
CVSYNC_TAG=latest

# Leave these unset to use the images built locally by `docker compose build`.
# Set them to pull from Docker Hub instead — this is what makes the app
# runnable on a machine that never had the source. scripts/push-to-dockerhub.sh
# prints the exact values after it pushes.
# FRONTEND_IMAGE=youruser/cvsync-frontend
# AUTH_IMAGE=youruser/cvsync-auth-service
# CVBRAIN_IMAGE=youruser/cvsync-cv-brain
# CVBUILDER_IMAGE=youruser/cvsync-cv-builder

# ── Host ports (change only if something else already uses them) ───────────
FRONTEND_PORT=5173
AUTH_PORT=4000
CV_BRAIN_PORT=8000
CV_BUILDER_PORT=3000

# ── CV_BRAIN — LLM keys ───────────────────────────────────────────────────
# At least one of these must be set or CV generation returns HTTP 400.
# OpenAI is tried first, Groq is the fallback.
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=8192

# CORS allowlist. /api/generate-cv spends LLM credits, so never widen to "*".
ALLOWED_ORIGINS=http://localhost:5173

# Finished CV length, in whole pages by default. "1,1.5,2" allows half pages.
PAGE_LENGTH_BANDS=1,2
ENABLE_PAGE_FIT=true
PAGE_FIT_MAX_ATTEMPTS=3
ENABLE_STRUCTURE_REVIEW=true

# ── auth-service — GitHub OAuth App ───────────────────────────────────────
# github.com/settings/developers. The callback URL must match the app exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
# read:user identifies the user and lists public repos. public_repo is a WRITE
# scope (push access to all your public repos) and is not needed.
GITHUB_OAUTH_SCOPE=read:user

# Google login exists in the code but is intentionally not wired up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

FRONTEND_URL=http://localhost:5173

# Session signing key. Generate with:  openssl rand -hex 32
# Leave the default ONLY for local testing — auth-service refuses to boot with
# it when NODE_ENV=production.
SESSION_SECRET=dev-secret-change-me

# Set to production only behind a TLS-terminating reverse proxy: it turns on
# secure cookies, which browsers refuse to send over plain HTTP (the symptom
# is "log in, immediately logged out").
NODE_ENV=development
COOKIE_SAMESITE=lax

LOGGER_LEVEL=info

# ── NOT settable here ─────────────────────────────────────────────────────
# VITE_API_URL / VITE_LLM_BRAIN_URL / VITE_CV_BUILDER_URL are inlined into the
# frontend bundle at BUILD time. To change them you must rebuild the frontend
# image with --build-arg. See DOCKER.md.
